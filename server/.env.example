PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/mentorconnect
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SESSION_COOKIE_NAME=mentorconnect.sid
CLIENT_ORIGIN=http://localhost:5173
# Metered TURN credentials; keep the API key server-side only.
METERED_APP_DOMAIN=
METERED_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/users/auth/google/callback
