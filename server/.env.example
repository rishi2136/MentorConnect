PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/mentorconnect
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SESSION_COOKIE_NAME=mentorconnect.sid
CLIENT_ORIGIN=http://localhost:5173
STUN_SERVER_URLS=stun:stun.l.google.com:19302
# Configure a TURN relay (e.g. coturn) for reliable calls across restrictive NAT/firewalls.
# Use comma-separated URLs, including both UDP/TCP or TLS endpoints if your TURN service supports them.
TURN_SERVER_URLS=
# coturn static-auth-secret; keep this secret on the server only.
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/users/auth/google/callback
